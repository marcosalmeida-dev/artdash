# Copie para ".env" (gitignored, mesma pasta do docker-compose.yml) e ajuste. O docker-compose lê estas
# variáveis; o ambiente do shell tem prioridade. O banco é um SQL Server externo (ARTDASH_CONNECTION_STRING);
# para criar o banco e o login numa instância local, use scripts/dev-db.ps1.

# Perfis ativos por padrão em "docker compose up": "tunnel" sobe também o Cloudflare Tunnel; vazio, só a aplicação.
COMPOSE_PROFILES=tunnel

# --- Aplicação ---
# Porta no host (só 127.0.0.1): http://localhost:8080
ARTDASH_HTTP_PORT=8080
ARTDASH_ENVIRONMENT=Production
# OBRIGATÓRIO: o SQL Server externo. Para uma instância no próprio host, use host.docker.internal, por exemplo:
# ARTDASH_CONNECTION_STRING='Server=host.docker.internal,1433;Database=ArtDash_Dev;User Id=artdash_dev;Password=ArtDash#Dev2026!;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Application Name=ArtDash'
ARTDASH_CONNECTION_STRING=
# OBRIGATÓRIO, mínimo 32 caracteres. Gere com: openssl rand -base64 48
ARTDASH_JWT_SIGNING_KEY=
# Domínio raiz: cada subdomínio vira o slug de uma empresa (acme.seudominio.com.br -> "acme").
ARTDASH_ROOT_DOMAIN=localhost
# Empresa usada quando o host não corresponde a nenhuma. Deixe vazio em produção multiempresa.
ARTDASH_DEFAULT_TENANT=demo
# Endereço público HTTPS (webhook do Mercado Pago), ex.: https://app.seudominio.com.br
ARTDASH_PUBLIC_URL=
# Documentação interativa da API em /scalar.
ARTDASH_API_REFERENCE=false
# Rede do compose; os X-Forwarded-* só são aceitos vindos dela (cloudflared).
ARTDASH_NETWORK_SUBNET=172.31.250.0/24

# Primeira empresa, criada na inicialização se ainda não existir. Sem e-mail e senha, o admin não é criado.
ARTDASH_SEED_ENABLED=true
ARTDASH_TENANT_SLUG=demo
ARTDASH_TENANT_NAME='Distribuidora Demo'
# Host público da empresa (ex.: pedidos.seudominio.com.br); localhost para testar sem túnel.
ARTDASH_TENANT_HOST=localhost
ARTDASH_ADMIN_EMAIL=
ARTDASH_ADMIN_PASSWORD=
# Dados de demonstração (categorias, produtos, clientes, pedidos).
ARTDASH_SAMPLE_DATA=false

# --- Cloudflare Tunnel (perfil "tunnel") ---
# Token do túnel nomeado: Zero Trust › Networks › Tunnels › (túnel) › Docker. Em "Public Hostnames", serviço
# HTTP "artdash:8080" (ou http://host.docker.internal:5180 para uma aplicação rodando no host).
CLOUDFLARE_TUNNEL_TOKEN=
# Fixe uma versão (ex.: 2025.10.0) para builds reproduzíveis.
CLOUDFLARED_VERSION=latest
