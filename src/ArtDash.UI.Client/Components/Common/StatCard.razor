@* A KPI tile. With Href it is a link to the list behind the number (an <a> without href is inert). *@
<a class="ad-stat ad-tone--@Color.ToString().ToLowerInvariant()" href="@Href">
    <span class="ad-stat__icon"><MudIcon Icon="@Icon" /></span>
    <span class="ad-stat__body">
        <span class="ad-stat__value">@Value</span>
        <span class="ad-stat__label">@Label</span>
        @if (!string.IsNullOrWhiteSpace(Hint))
        {
            <span class="ad-stat__hint">@Hint</span>
        }
    </span>
</a>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = Icons.Material.Rounded.Insights;
    [Parameter] public Color Color { get; set; } = Color.Primary;
    [Parameter] public string? Hint { get; set; }
    [Parameter] public string? Href { get; set; }
}
