@page "/conta/senha"
@attribute [Authorize]
@inject AccountApi Account
@inject UiActions Ui
@inject AuthSession Session
@inject NavigationManager Navigation

<div class="ad-page ad-page--narrow">
    <PageHeader Title="@L["Password.Title"]" Icon="@Icons.Material.Rounded.Password" />

    <section class="ad-card ad-card--form">
        <MudTextField T="string" @bind-Value="_request.CurrentPassword" Label="@L["Password.Current"]" Variant="Variant.Outlined"
                      InputType="InputType.Password" Immediate="true" Class="mb-3" />
        <MudTextField T="string" @bind-Value="_request.NewPassword" Label="@L["Password.New"]" Variant="Variant.Outlined"
                      InputType="InputType.Password" Immediate="true" HelperText="@L["Register.PasswordHint"]" Class="mb-3" />
        <MudTextField T="string" @bind-Value="_request.ConfirmNewPassword" Label="@L["Password.Confirm"]" Variant="Variant.Outlined"
                      InputType="InputType.Password" Immediate="true"
                      Error="@Differ" ErrorText="@L["Register.PasswordsDiffer"]" />

        <div class="d-flex justify-end gap-2 mt-4">
            <MudButton Variant="Variant.Text" OnClick="Back">@L["Common.Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" Disabled="@(!CanSave)" OnClick="SaveAsync">
                @L["Password.Save"]
            </MudButton>
        </div>
    </section>
</div>

@code {
    private readonly ChangePasswordRequest _request = new();
    private bool _saving;

    private bool Differ => !string.IsNullOrEmpty(_request.ConfirmNewPassword) && _request.NewPassword != _request.ConfirmNewPassword;

    private bool CanSave =>
        !_saving && !string.IsNullOrEmpty(_request.CurrentPassword) && _request.NewPassword.Length >= 8 && !Differ &&
        _request.ConfirmNewPassword.Length > 0;

    private async Task SaveAsync()
    {
        _saving = true;
        if (await Ui.RunAsync(() => Account.ChangePasswordAsync(_request), L["Password.Saved"]))
        {
            Back();
        }

        _saving = false;
    }

    private void Back() => Navigation.NavigateTo(LandingRoutes.For(Session.Principal));
}
