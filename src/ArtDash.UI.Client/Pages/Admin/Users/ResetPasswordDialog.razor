@inject UsersApi Users
@inject BrowserUtil Browser
@inject UiActions Ui

@* An admin sets a new password for someone who forgot theirs; every session of that user is signed out. *@
<MudDialog Class="ad-dialog">
    <DialogContent>
        @if (_done)
        {
            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">@L["Users.PasswordReset", UserName]</MudAlert>
            <div class="ad-copy-field">
                <code>@_password</code>
                <MudIconButton Icon="@Icons.Material.Rounded.ContentCopy" Size="Size.Small" aria-label="@L["Common.Copy"]" OnClick="CopyAsync" />
            </div>
            <p class="ad-muted ad-small mt-2">@L["Users.PasswordResetHint"]</p>
        }
        else
        {
            <p class="ad-muted mb-3">@L["Users.ResetPasswordFor", UserName]</p>
            <MudTextField T="string" @bind-Value="_password" Label="@L["Password.New"]" HelperText="@L["Register.PasswordHint"]"
                          Variant="Variant.Outlined" Margin="Margin.Dense" MaxLength="100" Immediate="true" AutoFocus="true"
                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Rounded.Casino"
                          OnAdornmentClick="@(() => _password = PasswordGenerator.New())" />
        }
    </DialogContent>
    <DialogActions>
        @if (_done)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" OnClick="@(() => MudDialog!.Close(DialogResult.Ok(true)))">
                @L["Common.Close"]
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" OnClick="@(() => MudDialog!.Cancel())">@L["Common.Cancel"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Warning" DropShadow="false" OnClick="SaveAsync"
                       Disabled="@(_saving || (_password?.Length ?? 0) < 8)" StartIcon="@Icons.Material.Rounded.LockReset">
                @L["Users.ResetPassword"]
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }

    [Parameter] public Guid UserId { get; set; }
    [Parameter] public string UserName { get; set; } = string.Empty;

    private string? _password = PasswordGenerator.New();
    private bool _saving;
    private bool _done;

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_password))
        {
            return;
        }

        _saving = true;
        var password = _password.Trim();
        if (await Ui.RunAsync(() => Users.ResetPasswordAsync(UserId, password)))
        {
            _password = password;
            _done = true;
        }

        _saving = false;
    }

    private async Task CopyAsync()
    {
        if (_password is not null && await Browser.CopyAsync(_password))
        {
            Ui.Success(L["Users.PasswordCopied"]);
        }
    }
}
