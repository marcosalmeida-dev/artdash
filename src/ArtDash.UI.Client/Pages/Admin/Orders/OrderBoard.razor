@page "/admin/pedidos/quadro"
@attribute [Authorize(Roles = AppRoles.Staff)]
@implements IAsyncDisposable
@inject OrdersApi Orders
@inject StoreState Store
@inject RealtimeClient Realtime
@inject UiActions Ui

@* Kanban of the open orders (artstore-fs' OrderKanban, simplified). Drag a card to move the order;
   only the moves Order.MoveTo allows are offered. "Out for delivery" is set by the driver's run. *@
<div class="ad-page ad-page--wide">
    <PageHeader Title="@L["Board.Title"]" Icon="@Icons.Material.Rounded.ViewKanban" Subtitle="@L["Board.Subtitle"]">
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Rounded.Refresh" OnClick="LoadAsync" Disabled="_loading">@L["Common.Refresh"]</MudButton>
        <MudButton Href="/admin/pedidos/novo" Variant="Variant.Filled" Color="Color.Primary" DropShadow="false" StartIcon="@Icons.Material.Rounded.Add">@L["Nav.NewOrder"]</MudButton>
    </PageHeader>

    @if (_orders is null)
    {
        <LoadingScreen />
    }
    else
    {
        <MudDropContainer @ref="_container" T="OrderListItemDto" Items="_orders"
                          ItemsSelector="@((item, zone) => item.Status.ToString() == zone)"
                          CanDrop="CanDrop" CanDropClass="ad-board__zone--can" NoDropClass="ad-board__zone--no"
                          ApplyDropClassesOnDragStarted="true" ItemDropped="OnDroppedAsync" Class="ad-board">
            <ChildContent>
                @foreach (var status in Columns)
                {
                    <div class="ad-board__column ad-tone--@StatusStyles.For(status).ToString().ToLowerInvariant()">
                        <div class="ad-board__head">
                            <MudIcon Icon="@StatusStyles.Icon(status)" Size="Size.Small" />
                            <span class="ad-board__name">@L.Enum(status)</span>
                            <span class="ad-board__count">@_orders.Count(o => o.Status == status)</span>
                        </div>
                        <MudDropZone T="OrderListItemDto" Identifier="@status.ToString()" Class="ad-board__zone" />
                    </div>
                }
            </ChildContent>
            <ItemRenderer>
                <div class="ad-board__card @(context.PaymentStatus == PaymentStatus.Paid ? "is-paid" : null)">
                    <div class="ad-board__card-top">
                        <a class="ad-link" href="@($"/admin/pedidos/{context.Id}")">#@context.Number</a>
                        <span class="ad-muted ad-small">@Fmt.Elapsed(DateTime.UtcNow - context.PlacedAt)</span>
                    </div>
                    <div class="ad-board__customer">@context.CustomerName</div>
                    @if (!string.IsNullOrWhiteSpace(context.District))
                    {
                        <div class="ad-muted ad-small">@context.District</div>
                    }
                    <div class="ad-board__card-bottom">
                        <strong>@Fmt.Money(context.Total)</strong>
                        <StatusChip Text="@L.Enum(context.PaymentStatus)" Color="@StatusStyles.For(context.PaymentStatus)" Variant="Variant.Outlined" />
                    </div>
                    <div class="ad-board__tags">
                        <span><MudIcon Icon="@StatusStyles.Icon(context.PaymentTiming)" Size="Size.Small" /> @L.Enum(context.PaymentTiming)</span>
                        @if (context.DeliveryId is not null)
                        {
                            <span><MudIcon Icon="@Icons.Material.Rounded.Route" Size="Size.Small" /> @L["Board.InDelivery"]</span>
                        }
                        @if (context.Channel == OrderChannel.Backoffice)
                        {
                            <span><MudIcon Icon="@Icons.Material.Rounded.SupportAgent" Size="Size.Small" /> @L.Enum(context.Channel)</span>
                        }
                    </div>
                </div>
            </ItemRenderer>
        </MudDropContainer>
    }
</div>

@code {
    private static readonly OrderStatus[] Columns =
    [
        OrderStatus.Pending, OrderStatus.Confirmed, OrderStatus.Preparing, OrderStatus.ReadyForDelivery, OrderStatus.OutForDelivery
    ];

    private MudDropContainer<OrderListItemDto>? _container;
    private List<OrderListItemDto>? _orders;
    private bool _loading;
    private CancellationTokenSource? _debounce;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
        Realtime.OrderChanged += OnOrderChangedAsync;
        await Realtime.EnsureStartedAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var orders = await Ui.LoadAsync(() => Orders.GetBoardAsync());
        if (orders is not null)
        {
            _orders = orders.ToList();
        }

        _orders ??= [];
        _loading = false;
        _container?.Refresh();
    }

    private bool CanDrop(OrderListItemDto item, string zone) =>
        Enum.TryParse<OrderStatus>(zone, out var target) &&
        StatusStyles.ManualTargets(item.Status, item.PaymentTiming, item.PaymentStatus, item.DeliveryId is not null).Contains(target);

    private async Task OnDroppedAsync(MudItemDropInfo<OrderListItemDto> drop)
    {
        if (drop.Item is null || !Enum.TryParse<OrderStatus>(drop.DropzoneIdentifier, out var target) || target == drop.Item.Status)
        {
            return;
        }

        var item = drop.Item;
        var index = _orders!.IndexOf(item);
        if (index >= 0)
        {
            // Optimistic: move the card now, put it back if the API refuses.
            _orders[index] = item with { Status = target };
            _container?.Refresh();
        }

        if (!await Ui.RunAsync(() => Orders.ChangeStatusAsync(item.Id, target)))
        {
            await LoadAsync();
        }
    }

    private async Task OnOrderChangedAsync(OrderChangedMessage message)
    {
        var isNew = message.Status == OrderStatus.Pending && _orders?.All(o => o.Id != message.OrderId) == true;
        if (isNew)
        {
            await InvokeAsync(() => Ui.Info(L["Board.NewOrder", message.Number, message.CustomerName]));
        }

        _debounce?.Cancel();
        _debounce = new CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(400, token);
            await InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
        catch (TaskCanceledException)
        {
        }
    }

    public ValueTask DisposeAsync()
    {
        Realtime.OrderChanged -= OnOrderChangedAsync;
        _debounce?.Cancel();
        return ValueTask.CompletedTask;
    }
}
