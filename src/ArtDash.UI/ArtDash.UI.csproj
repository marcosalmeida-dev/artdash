<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The web host: REST API (controllers), SignalR hub, and the Blazor Server host for the components
    in ArtDash.UI.Client. Composition root — the only project that references every layer.
  -->
  <PropertyGroup>
    <RootNamespace>ArtDash.UI</RootNamespace>
    <UserSecretsId>artdash-ui-6d3f1f0e-2b5c-4c1e-9a77-0c6f1d2a9b10</UserSecretsId>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!--
      Ships _framework/blazor.web.js. The SDK infers this from .razor files at restore time, so a restore
      that only sees the .csproj (the cached restore layer in the Dockerfile) would leave it out.
    -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArtDash.Infrastructure\ArtDash.Infrastructure.csproj" />
    <ProjectReference Include="..\ArtDash.UI.Client\ArtDash.UI.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime data (uploads, logs) never ships with a publish. -->
    <Content Remove="App_Data\**" />
    <None Remove="App_Data\**" />
  </ItemGroup>

</Project>
