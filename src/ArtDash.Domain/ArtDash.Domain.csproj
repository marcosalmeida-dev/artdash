<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Entities, value objects, domain events and business rules.
    Only depends on Shared (enums) and on the Identity *stores* abstractions (IdentityUser<TKey>),
    never on EF Core: persistence concerns live in Infrastructure.
  -->
  <PropertyGroup>
    <RootNamespace>ArtDash.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ArtDash.Shared\ArtDash.Shared.csproj" />
  </ItemGroup>

</Project>
